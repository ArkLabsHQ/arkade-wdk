{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "stripInternal": true,
    "resolveJsonModule": true,
    "outDir": "./types",
    "baseUrl": ".",
    "paths": {
      "sodium-universal": ["src/types/sodium-universal.d.ts"]
    }
  },
  "include": ["src/**/*.js", "src/**/*.d.ts"],
  "exclude": ["node_modules", "src/__tests__/**", "types"]
}
