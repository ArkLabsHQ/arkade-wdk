diff --git a/.env.example b/.env.example
index fe78808..ce4c020 100644
--- a/.env.example
+++ b/.env.example
@@ -1,4 +1,20 @@
 EXPO_PUBLIC_WDK_INDEXER_BASE_URL=https://wdk-api.tether.io
 EXPO_PUBLIC_WDK_INDEXER_API_KEY=PUT_WDK_API_KEY_HERE
 EXPO_PUBLIC_TRON_API_KEY=PUT_HERE
-EXPO_PUBLIC_TRON_API_SECRET=PUT_HERE
\ No newline at end of file
+EXPO_PUBLIC_TRON_API_SECRET=PUT_HERE
+# --- Arkade ---
+# REST endpoint of the Ark server the wallet talks to. Override locally for
+# regtest / mutinynet (e.g. http://192.168.1.10:7070).
+EXPO_PUBLIC_ARKADE_SERVER_URL=https://arkade.computer
+# VTXO indexer / "virtual mempool" URL. If omitted, the SDK defaults to the
+# Ark server's built-in indexer. Set this when the indexer lives at a separate
+# domain (mutinynet: https://explorer.mutinynet.arkade.sh, mainnet:
+# https://arkade.space).
+# EXPO_PUBLIC_ARKADE_INDEXER_URL=
+# Boltz swap provider. Required only if you want to use Lightning send /
+# receive — without it the receive Lightning flow will throw and the send
+# flow falls back to the no-swap-provider error path.
+EXPO_PUBLIC_ARKADE_SWAP_PROVIDER_URL=https://api.ark.boltz.exchange
+# Esplora REST endpoint used by the RN-side balance workaround for
+# on-chain BTC boarding deposits. Override for regtest / mutinynet.
+EXPO_PUBLIC_ESPLORA_URL=https://blockstream.info/api
\ No newline at end of file
