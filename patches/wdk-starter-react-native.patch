diff --git a/scripts/link-bare-addons.mjs b/scripts/link-bare-addons.mjs
new file mode 100644
index 0000000..dfe882d
--- /dev/null
+++ b/scripts/link-bare-addons.mjs
@@ -0,0 +1,29 @@
+import { spawnSync } from 'node:child_process';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const scriptDir = path.dirname(fileURLToPath(import.meta.url));
+const projectRoot = path.resolve(scriptDir, '..');
+
+const runNodeScript = (scriptPath) => {
+  const result = spawnSync(process.execPath, [scriptPath], {
+    cwd: projectRoot,
+    stdio: 'inherit',
+  });
+
+  if (result.status !== 0) {
+    process.exit(result.status ?? 1);
+  }
+};
+
+runNodeScript(
+  path.join(projectRoot, 'node_modules', 'react-native-bare-kit', 'android', 'link.js')
+);
+
+if (process.platform === 'darwin') {
+  runNodeScript(
+    path.join(projectRoot, 'node_modules', 'react-native-bare-kit', 'ios', 'link.js')
+  );
+} else {
+  console.log('Skipping iOS bare addon linking on non-macOS host.');
+}
diff --git a/scripts/link-local-packages.mjs b/scripts/link-local-packages.mjs
new file mode 100644
index 0000000..92a7c45
--- /dev/null
+++ b/scripts/link-local-packages.mjs
@@ -0,0 +1,55 @@
+import { access, lstat, mkdir, readlink, rm, symlink } from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const scriptDir = path.dirname(fileURLToPath(import.meta.url));
+const projectRoot = path.resolve(scriptDir, '..');
+const scopeDir = path.join(projectRoot, 'node_modules', '@tetherto');
+
+const localPackages = [
+  {
+    name: 'pear-wrk-wdk',
+    target: path.resolve(projectRoot, '..', '..', 'packages', 'pear-wrk-wdk'),
+  },
+  {
+    name: 'wdk-react-native-provider',
+    target: path.resolve(projectRoot, '..', '..', 'packages', 'wdk-react-native-provider'),
+  },
+];
+
+const ensureSymlink = async (linkPath, targetPath) => {
+  try {
+    const stat = await lstat(linkPath);
+
+    if (stat.isSymbolicLink()) {
+      const currentTarget = await readlink(linkPath);
+      const resolvedTarget = path.resolve(path.dirname(linkPath), currentTarget);
+
+      if (resolvedTarget === targetPath) {
+        return;
+      }
+    }
+
+    await rm(linkPath, { force: true, recursive: true });
+  } catch {
+    // Path does not exist yet.
+  }
+
+  await symlink(targetPath, linkPath, 'dir');
+};
+
+await mkdir(scopeDir, { recursive: true });
+
+for (const pkg of localPackages) {
+  try {
+    await access(pkg.target);
+  } catch {
+    throw new Error(
+      `Missing local package path for @tetherto/${pkg.name}: ${pkg.target}. Did you clone submodules?`
+    );
+  }
+
+  const linkPath = path.join(scopeDir, pkg.name);
+  await ensureSymlink(linkPath, pkg.target);
+  console.log(`Linked @tetherto/${pkg.name} -> ${pkg.target}`);
+}
