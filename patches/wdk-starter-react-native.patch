diff --git a/src/app/receive/lightning.tsx b/src/app/receive/lightning.tsx
new file mode 100644
index 0000000..0729d9a
--- /dev/null
+++ b/src/app/receive/lightning.tsx
@@ -0,0 +1,336 @@
+import { QRCode } from '@tetherto/wdk-uikit-react-native';
+import { useLocalSearchParams } from 'expo-router';
+import { useDebouncedNavigation } from '@/hooks/use-debounced-navigation';
+import { useWallet } from '@tetherto/wdk-react-native-provider';
+import * as Clipboard from 'expo-clipboard';
+import { ArrowLeft, Copy, Share, X } from 'lucide-react-native';
+import React, { useCallback, useState } from 'react';
+import {
+  ActivityIndicator,
+  Share as RNShare,
+  StyleSheet,
+  Text,
+  TextInput,
+  TouchableOpacity,
+  View,
+} from 'react-native';
+import { useSafeAreaInsets } from 'react-native-safe-area-context';
+import { toast } from 'sonner-native';
+import { colors } from '@/constants/colors';
+
+type Phase = 'amount' | 'invoice';
+
+export default function LightningReceiveScreen() {
+  const insets = useSafeAreaInsets();
+  const router = useDebouncedNavigation();
+  const { createLightningInvoice } = useWallet();
+  const params = useLocalSearchParams();
+
+  const { tokenName } = params as { tokenName: string };
+
+  const [phase, setPhase] = useState<Phase>('amount');
+  const [amountSats, setAmountSats] = useState('');
+  const [description, setDescription] = useState('');
+  const [invoice, setInvoice] = useState('');
+  const [isGenerating, setIsGenerating] = useState(false);
+
+  const handleBack = useCallback(() => {
+    if (phase === 'invoice') {
+      setPhase('amount');
+      setInvoice('');
+    } else {
+      router.back();
+    }
+  }, [phase, router]);
+
+  const handleClose = useCallback(() => {
+    router.dismissAll();
+  }, [router]);
+
+  const handleGenerate = useCallback(async () => {
+    const sats = parseInt(amountSats, 10);
+    if (!sats || sats <= 0) {
+      toast.error('Enter a valid amount in sats');
+      return;
+    }
+
+    setIsGenerating(true);
+    try {
+      const result = await createLightningInvoice(
+        sats,
+        description || undefined
+      );
+      setInvoice(result.invoice);
+      setPhase('invoice');
+    } catch (error) {
+      toast.error(
+        error instanceof Error ? error.message : 'Failed to create invoice'
+      );
+    } finally {
+      setIsGenerating(false);
+    }
+  }, [amountSats, description, createLightningInvoice]);
+
+  const handleCopy = useCallback(async () => {
+    try {
+      await Clipboard.setStringAsync(invoice);
+      toast.success('Invoice copied to clipboard');
+    } catch (error) {
+      console.error('Error copying invoice:', error);
+      toast.error('Failed to copy invoice');
+    }
+  }, [invoice]);
+
+  const handleShare = useCallback(async () => {
+    try {
+      await RNShare.share({
+        message: invoice,
+        title: `${tokenName} Lightning Invoice`,
+      });
+    } catch (error) {
+      console.error('Error sharing invoice:', error);
+    }
+  }, [invoice, tokenName]);
+
+  return (
+    <View style={[styles.container, { paddingTop: insets.top }]}>
+      <View style={styles.header}>
+        <TouchableOpacity style={styles.backButton} onPress={handleBack}>
+          <ArrowLeft size={24} color={colors.primary} />
+          <Text style={styles.backText}>Back</Text>
+        </TouchableOpacity>
+        <Text style={styles.headerTitle}>Lightning</Text>
+        <TouchableOpacity style={styles.closeButton} onPress={handleClose}>
+          <X size={24} color={colors.primary} />
+        </TouchableOpacity>
+      </View>
+
+      {phase === 'amount' ? (
+        <View style={styles.content}>
+          <View style={styles.titleSection}>
+            <Text style={styles.title}>
+              Generate a Lightning invoice to receive {tokenName}
+            </Text>
+          </View>
+
+          <View style={styles.inputSection}>
+            <Text style={styles.inputLabel}>Amount (sats)</Text>
+            <TextInput
+              style={styles.input}
+              value={amountSats}
+              onChangeText={setAmountSats}
+              placeholder="e.g. 10000"
+              placeholderTextColor={colors.textTertiary}
+              keyboardType="numeric"
+              autoFocus
+            />
+
+            <Text style={[styles.inputLabel, styles.descriptionLabel]}>
+              Description (optional)
+            </Text>
+            <TextInput
+              style={styles.input}
+              value={description}
+              onChangeText={setDescription}
+              placeholder="What is this payment for?"
+              placeholderTextColor={colors.textTertiary}
+            />
+          </View>
+
+          <TouchableOpacity
+            style={[
+              styles.generateButton,
+              (!amountSats || isGenerating) && styles.generateButtonDisabled,
+            ]}
+            onPress={handleGenerate}
+            disabled={!amountSats || isGenerating}
+            activeOpacity={0.7}
+          >
+            {isGenerating ? (
+              <ActivityIndicator color={colors.white} />
+            ) : (
+              <Text style={styles.generateButtonText}>Generate Invoice</Text>
+            )}
+          </TouchableOpacity>
+        </View>
+      ) : (
+        <View style={styles.content}>
+          <View style={styles.titleSection}>
+            <Text style={styles.title}>
+              Send {amountSats} sats to this invoice
+            </Text>
+          </View>
+
+          <QRCode
+            value={invoice}
+            label="Scan QR code"
+            size={200}
+            color={colors.primary}
+            containerStyle={styles.qrSection}
+          />
+
+          <View style={styles.addressSection}>
+            <View style={styles.addressContainer}>
+              <Text
+                style={styles.addressText}
+                numberOfLines={3}
+                ellipsizeMode="middle"
+              >
+                {invoice}
+              </Text>
+            </View>
+
+            <View style={styles.buttonsContainer}>
+              <TouchableOpacity
+                style={[styles.actionButton, styles.copyButton]}
+                onPress={handleCopy}
+                activeOpacity={0.7}
+              >
+                <Copy size={20} color={colors.white} />
+                <Text style={styles.actionButtonText}>Copy</Text>
+              </TouchableOpacity>
+
+              <TouchableOpacity
+                style={[styles.actionButton, styles.shareButton]}
+                onPress={handleShare}
+                activeOpacity={0.7}
+              >
+                <Share size={20} color={colors.white} />
+                <Text style={styles.actionButtonText}>Share</Text>
+              </TouchableOpacity>
+            </View>
+          </View>
+        </View>
+      )}
+    </View>
+  );
+}
