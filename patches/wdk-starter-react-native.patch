diff --git a/src/app/receive/lightning.tsx b/src/app/receive/lightning.tsx
new file mode 100644
index 0000000..2effa36
--- /dev/null
+++ b/src/app/receive/lightning.tsx
@@ -0,0 +1,374 @@
+import { QRCode } from '@tetherto/wdk-uikit-react-native';
+import { useLocalSearchParams } from 'expo-router';
+import { useDebouncedNavigation } from '@/hooks/use-debounced-navigation';
+import { useWallet } from '@tetherto/wdk-react-native-provider';
+import * as Clipboard from 'expo-clipboard';
+import { ArrowLeft, Copy, Share, X, Zap } from 'lucide-react-native';
+import React, { useCallback, useEffect, useState } from 'react';
+import {
+  ActivityIndicator,
+  Share as RNShare,
+  StyleSheet,
+  Text,
+  TextInput,
+  TouchableOpacity,
+  View,
+} from 'react-native';
+import { useSafeAreaInsets } from 'react-native-safe-area-context';
+import { toast } from 'sonner-native';
+import { colors } from '@/constants/colors';
+
+export default function ReceiveLightningScreen() {
+  const insets = useSafeAreaInsets();
+  const router = useDebouncedNavigation();
+  const params = useLocalSearchParams();
+  const { createLightningInvoice, getLightningFees, setIncomingFundsPollingInterval } = useWallet();
+
+  const { tokenName } = params as {
+    tokenId: string;
+    tokenSymbol: string;
+    tokenName: string;
+  };
+
+  const [amount, setAmount] = useState('');
+  const [description, setDescription] = useState('');
+  const [invoice, setInvoice] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [fees, setFees] = useState<{
+    percentage: number;
+    minerFees: { claim: number; lockup: number };
+    limits: { min: number; max: number };
+  } | null>(null);
+
+  // Fast-poll while on the receive screen
+  useEffect(() => {
+    setIncomingFundsPollingInterval(2000);
+    return () => setIncomingFundsPollingInterval(10000);
+  }, [setIncomingFundsPollingInterval]);
+
+  useEffect(() => {
+    getLightningFees().then(setFees).catch(() => {});
+  }, [getLightningFees]);
+
+  const handleBack = useCallback(() => {
+    if (invoice) {
+      setInvoice(null);
+    } else {
+      router.back();
+    }
+  }, [router, invoice]);
+
+  const handleClose = useCallback(() => {
+    router.dismissAll();
+  }, [router]);
+
+  const handleCreateInvoice = useCallback(async () => {
+    const amountSats = parseInt(amount, 10);
+    if (!amountSats || amountSats <= 0) {
+      toast.error('Please enter a valid amount');
+      return;
+    }
+    if (fees && (amountSats < fees.limits.min || amountSats > fees.limits.max)) {
+      toast.error(`Amount must be between ${fees.limits.min} and ${fees.limits.max} sats`);
+      return;
+    }
+    setLoading(true);
+    try {
+      const result = await createLightningInvoice(amountSats, description || undefined);
+      setInvoice(result.invoice);
+    } catch (error) {
+      console.error('Error creating invoice:', error);
+      toast.error('Failed to create Lightning invoice');
+    } finally {
+      setLoading(false);
+    }
+  }, [amount, description, fees, createLightningInvoice]);
+
+  const handleCopyInvoice = useCallback(async () => {
+    if (!invoice) return;
+    try {
+      await Clipboard.setStringAsync(invoice);
+      toast.success('Invoice copied to clipboard');
+    } catch (error) {
+      console.error('Error copying invoice:', error);
+      toast.error('Failed to copy invoice');
+    }
+  }, [invoice]);
+
+  const handleShareInvoice = useCallback(async () => {
+    if (!invoice) return;
+    try {
+      await RNShare.share({ message: invoice, title: 'Lightning Invoice' });
+    } catch (error) {
+      console.error('Error sharing invoice:', error);
+    }
+  }, [invoice]);
+
+  if (invoice) {
+    return (
+      <View style={[styles.container, { paddingTop: insets.top }]}>
+        <View style={styles.header}>
+          <TouchableOpacity style={styles.backButton} onPress={handleBack}>
+            <ArrowLeft size={24} color={colors.primary} />
+            <Text style={styles.backText}>Back</Text>
+          </TouchableOpacity>
+          <Text style={styles.headerTitle}>Lightning Invoice</Text>
+          <TouchableOpacity style={styles.closeButton} onPress={handleClose}>
+            <X size={24} color={colors.primary} />
+          </TouchableOpacity>
+        </View>
+
+        <View style={styles.content}>
+          <View style={styles.titleSection}>
+            <Text style={styles.title}>
+              Receive {amount} sats via Lightning
+            </Text>
+          </View>
+
+          <QRCode
+            value={invoice}
+            label="Scan to pay"
+            size={200}
+            color={colors.primary}
+            containerStyle={styles.qrSection}
+          />
+
+          <View style={styles.addressSection}>
+            <View style={styles.addressContainer}>
+              <Text style={styles.addressText} numberOfLines={3} ellipsizeMode="middle">
+                {invoice}
+              </Text>
+            </View>
+
+            <View style={styles.buttonsContainer}>
+              <TouchableOpacity
+                style={[styles.actionButton, styles.copyButton]}
+                onPress={handleCopyInvoice}
+                activeOpacity={0.7}
+              >
+                <Copy size={20} color={colors.white} />
+                <Text style={styles.actionButtonText}>Copy</Text>
+              </TouchableOpacity>
+
+              <TouchableOpacity
+                style={[styles.actionButton, styles.shareButton]}
+                onPress={handleShareInvoice}
+                activeOpacity={0.7}
+              >
+                <Share size={20} color={colors.white} />
+                <Text style={styles.actionButtonText}>Share</Text>
+              </TouchableOpacity>
+            </View>
+          </View>
+        </View>
+      </View>
+    );
+  }
+
+  return (
+    <View style={[styles.container, { paddingTop: insets.top }]}>
+      <View style={styles.header}>
+        <TouchableOpacity style={styles.backButton} onPress={handleBack}>
+          <ArrowLeft size={24} color={colors.primary} />
+          <Text style={styles.backText}>Back</Text>
+        </TouchableOpacity>
+        <Text style={styles.headerTitle}>Receive via Lightning</Text>
+        <TouchableOpacity style={styles.closeButton} onPress={handleClose}>
+          <X size={24} color={colors.primary} />
+        </TouchableOpacity>
+      </View>
+
+      <View style={styles.content}>
+        <View style={styles.titleSection}>
+          <Zap size={32} color={colors.primary} />
+          <Text style={styles.title}>
+            Receive {tokenName} via Lightning Network
+          </Text>
+        </View>
+
+        <View style={styles.formSection}>
+          <Text style={styles.label}>Amount (sats)</Text>
+          <TextInput
+            style={styles.input}
+            value={amount}
+            onChangeText={setAmount}
+            placeholder={
+              fees ? `${fees.limits.min} – ${fees.limits.max}` : 'Enter amount in sats'
+            }
+            placeholderTextColor={colors.textTertiary}
+            keyboardType="numeric"
+          />
+
+          <Text style={styles.label}>Description (optional)</Text>
+          <TextInput
+            style={styles.input}
+            value={description}
+            onChangeText={setDescription}
+            placeholder="What is this payment for?"
+            placeholderTextColor={colors.textTertiary}
+          />
+
+          {fees && (
+            <Text style={styles.feeInfo}>
+              Fee: {fees.percentage}% + {fees.minerFees.claim + fees.minerFees.lockup} sats miner fee
+            </Text>
+          )}
+        </View>
+
+        <TouchableOpacity
+          style={[styles.createButton, loading && styles.createButtonDisabled]}
+          onPress={handleCreateInvoice}
+          disabled={loading}
+          activeOpacity={0.7}
+        >
+          {loading ? (
+            <ActivityIndicator color={colors.white} />
+          ) : (
+            <>
+              <Zap size={20} color={colors.white} />
+              <Text style={styles.createButtonText}>Create Invoice</Text>
+            </>
+          )}
+        </TouchableOpacity>
+      </View>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  container: {
+    flex: 1,
+    backgroundColor: colors.background,
+  },
+  header: {
+    flexDirection: 'row',
+    alignItems: 'center',
+    justifyContent: 'space-between',
+    paddingHorizontal: 20,
+    paddingVertical: 16,
+  },
+  backButton: {
+    flexDirection: 'row',
+    alignItems: 'center',
+  },
+  backText: {
+    color: colors.primary,
+    fontSize: 16,
+    marginLeft: 4,
+  },
+  headerTitle: {
+    fontSize: 18,
+    fontWeight: '600',
+    color: colors.text,
+  },
+  closeButton: {
+    padding: 4,
+  },
+  content: {
+    flex: 1,
+    paddingHorizontal: 20,
+  },
+  titleSection: {
+    flexDirection: 'row',
+    alignItems: 'center',
+    gap: 12,
+    marginBottom: 32,
+  },
+  title: {
+    fontSize: 20,
+    fontWeight: '600',
+    color: colors.text,
+    lineHeight: 28,
+    flex: 1,
+  },
+  formSection: {
+    marginBottom: 32,
+  },
+  label: {
+    fontSize: 14,
+    fontWeight: '500',
+    color: colors.textSecondary,
+    marginBottom: 8,
+  },
+  input: {
+    backgroundColor: colors.card,
+    borderRadius: 12,
+    paddingHorizontal: 16,
+    paddingVertical: 14,
+    fontSize: 16,
+    color: colors.text,
