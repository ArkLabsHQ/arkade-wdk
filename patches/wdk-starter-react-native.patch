diff --git a/metro.config.js b/metro.config.js
index dba8528..74d674a 100644
--- a/metro.config.js
+++ b/metro.config.js
@@ -17,11 +17,20 @@ config.resolver = {
   sourceExts: [...resolver.sourceExts, 'svg'],
   // Ensure module paths include root node_modules
   nodeModulesPaths: [path.resolve(__dirname, 'node_modules')],
+  // Follow npm link symlinks (needed for local dev with linked submodules)
+  unstable_enableSymlinks: true,
   alias: {
     '@': path.resolve(__dirname, 'src'),
   },
 };
 
+// Watch linked package directories so Metro can resolve their modules
+config.watchFolders = [
+  path.resolve(__dirname, '../..'), // @arkade-os/wdk root (+ its node_modules)
+  path.resolve(__dirname, '../../packages/wdk-react-native-provider'),
+  path.resolve(__dirname, '../../packages/pear-wrk-wdk'),
+];
+
 // Apply WDK polyfills configuration first (handles Node.js core module polyfills)
 const wdkConfig = configureMetroForWDK(config);
 
