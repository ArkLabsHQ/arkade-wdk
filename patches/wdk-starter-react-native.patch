diff --git a/src/utils/lightning-invoice.ts b/src/utils/lightning-invoice.ts
new file mode 100644
index 0000000..52764b1
--- /dev/null
+++ b/src/utils/lightning-invoice.ts
@@ -0,0 +1,42 @@
+import bolt11 from 'light-bolt11-decoder';
+
+interface DecodedInvoice {
+  note: string;
+  expiry: number;
+  amountSats: number;
+  paymentHash: string;
+}
+
+function extractNote(data: string): string {
+  if (!/^\[/.test(data)) return data;
+  try {
+    return JSON.parse(data)[0][1];
+  } catch {
+    return '';
+  }
+}
+
+export function decodeInvoice(invoice: string): DecodedInvoice {
+  const decoded = bolt11.decode(invoice);
+  const millisats = Number(
+    decoded.sections.find((s: { name: string }) => s.name === 'amount')?.value ?? '0'
+  );
+  const description =
+    decoded.sections.find((s: { name: string }) => s.name === 'description')?.value ?? '';
+  return {
+    expiry: decoded.expiry ?? 3600,
+    note: extractNote(description as string),
+    amountSats: Math.floor(millisats / 1000),
+    paymentHash: (decoded.sections.find((s: { name: string }) => s.name === 'payment_hash')
+      ?.value ?? '') as string,
+  };
+}
+
+export function isLightningInvoice(data: string): boolean {
+  try {
+    decodeInvoice(data);
+    return true;
+  } catch {
+    return false;
+  }
+}
