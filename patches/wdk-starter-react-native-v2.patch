diff --git a/src/utils/address-validators.ts b/src/utils/address-validators.ts
index 3f97d8d..564de7d 100644
--- a/src/utils/address-validators.ts
+++ b/src/utils/address-validators.ts
@@ -61,6 +61,49 @@ export function validateSparkAddress(address: string): AddressValidationResult {
   return { valid: true };
 }
 
+// Arkade supports Bitcoin addresses (on-chain), Ark addresses (VTXOs), and Lightning invoices
+const ARK_ADDRESS_PREFIXES = ['ark1', 'tark1']; // mainnet and testnet Ark addresses
+
+export function validateArkadeAddress(address: string): AddressValidationResult {
+  const trimmed = address.trim();
+
+  // Check for Lightning invoice (BOLT11)
+  if (trimmed.toLowerCase().startsWith('lnbc') || trimmed.toLowerCase().startsWith('lntb') || trimmed.toLowerCase().startsWith('lnbcrt')) {
+    // Basic Lightning invoice validation - must be longer than prefix
+    if (trimmed.length > 10) {
+      return { valid: true };
+    }
+    return {
+      valid: false,
+      error: 'Invalid Lightning invoice format.',
+    };
+  }
+
+  // Check for Ark address (VTXO)
+  const hasArkPrefix = ARK_ADDRESS_PREFIXES.some(prefix => trimmed.toLowerCase().startsWith(prefix));
+  if (hasArkPrefix) {
+    // Basic bech32m validation for Ark addresses
+    if (trimmed.length >= 40 && trimmed.length <= 100) {
+      return { valid: true };
+    }
+    return {
+      valid: false,
+      error: 'Invalid Ark address length.',
+    };
+  }
+
+  // Check for Bitcoin address (on-chain boarding/withdrawal)
+  const isValidBtc = WAValidator.validate(trimmed, 'btc');
+  if (isValidBtc) {
+    return { valid: true };
+  }
+
+  return {
+    valid: false,
+    error: 'Invalid Arkade address. Accepts Bitcoin addresses, Ark addresses (ark1...), or Lightning invoices (lnbc...).',
+  };
+}
