diff --git a/shims/bare-type-jsshim/index.js b/shims/bare-type-jsshim/index.js
new file mode 100644
index 0000000..efc6435
--- /dev/null
+++ b/shims/bare-type-jsshim/index.js
@@ -0,0 +1,261 @@
+// Pure-JS shim for the `bare-type` package, used by bare-pack via
+// pack.imports.json. The upstream package uses a native addon
+// (libbare-type.so) that react-native-bare-kit doesn't ship, so the
+// worklet would otherwise fail at runtime with ADDON_NOT_FOUND when
+// any transitive dep (e.g. bare-utils → node:util/types) walks the
+// type-predicate path.
+//
+// The native version returns a packed numeric type code; the JS shim
+// captures the value and answers `is*` queries via standard typeof /
+// instanceof / Symbol.toStringTag checks. Predicates that can only be
+// answered by a native runtime (Proxy, External, ModuleNamespace) are
+// stubbed to `false`, which matches what bare-utils consumers do —
+// they treat unknown types as "not that".
+'use strict'
+
+class Type {
+  constructor(value) {
+    this._value = value
+    this._typeof = typeof value
+  }
+
+  isUndefined() {
+    return this._typeof === 'undefined'
+  }
+
+  isNull() {
+    return this._value === null
+  }
+
+  isBoolean() {
+    return this._typeof === 'boolean'
+  }
+
+  isNumber() {
+    return this._typeof === 'number'
+  }
+
+  isInt32() {
+    return (
+      this._typeof === 'number' &&
+      Number.isInteger(this._value) &&
+      this._value >= -0x80000000 &&
+      this._value <= 0x7fffffff
+    )
+  }
+
+  isUint32() {
+    return (
+      this._typeof === 'number' &&
+      Number.isInteger(this._value) &&
+      this._value >= 0 &&
+      this._value <= 0xffffffff
+    )
+  }
+
+  isString() {
+    return this._typeof === 'string'
+  }
+
+  isSymbol() {
+    return this._typeof === 'symbol'
+  }
+
+  isObject() {
+    return this._typeof === 'object' && this._value !== null
+  }
+
+  isArray() {
+    return Array.isArray(this._value)
+  }
+
+  isArguments() {
+    return Object.prototype.toString.call(this._value) === '[object Arguments]'
+  }
+
+  isDate() {
+    return this._value instanceof Date
+  }
+
+  isRegExp() {
+    return this._value instanceof RegExp
+  }
+
+  isError() {
+    return this._value instanceof Error
+  }
+
+  isPromise() {
+    return (
+      this._value !== null &&
