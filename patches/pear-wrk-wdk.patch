diff --git a/shims/bare-stdio-jsshim/index.js b/shims/bare-stdio-jsshim/index.js
new file mode 100644
index 0000000..60370e7
--- /dev/null
+++ b/shims/bare-stdio-jsshim/index.js
@@ -0,0 +1,22 @@
+// Pure-JS shim for bare-stdio. The upstream package wraps fd 0/1/2 using
+// bare-tty, bare-pipe, and bare-fs — all of which need native addons that
+// react-native-bare-kit may not ship. In the RN worklet context, stdin/
+// stdout/stderr are not meaningfully available; this shim provides no-op
+// streams so consumers that probe process.stdin/stdout/stderr don't crash.
+'use strict'
+
+const { Writable, Readable } = require('streamx')
+
+class NullWritable extends Writable {
+  _write (data, cb) { cb(null) }
+}
+
+class NullReadable extends Readable {
+  _read (cb) { this.push(null); cb(null) }
+}
+
+module.exports = {
+  get in () { return new NullReadable() },
+  get out () { return new NullWritable() },
+  get err () { return new NullWritable() }
+}
