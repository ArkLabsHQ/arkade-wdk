+// Pure-JS shim for bare-abort. The upstream package calls a native addon to
+// trigger an immediate process abort. In the RN worklet context there's no
+// meaningful abort — throwing is the closest JS equivalent.
+'use strict'
+
+module.exports = function abort () {
+  throw new Error('process.abort() called (bare-abort-jsshim)')
+}
