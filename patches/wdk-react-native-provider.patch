+                  new Error(
+                    `${asset}/${networkType} address resolution timed out after ${ADDRESS_RESOLUTION_TIMEOUT_MS}ms`
+                  )
+                ),
+              ADDRESS_RESOLUTION_TIMEOUT_MS
+            );
+          }),
+        ]).finally(() => clearTimeout(timeoutId));
+        addressPromises.push(raced);
