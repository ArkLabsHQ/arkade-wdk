{
  "name": "@arkade-os/wdk",
  "version": "0.1.0",
  "description": "WDK (Wallet Development Kit) implementation using Arkade Bitcoin SDK with Ark protocol support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bare": "./bare.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rimraf dist",
    "setup:dev": "node scripts/setup-dev.js"
  },
  "keywords": [
    "bitcoin",
    "ark",
    "wallet",
    "wdk",
    "arkade",
    "cryptocurrency",
    "blockchain"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@arkade-os/boltz-swap": "^0.2.20",
    "@arkade-os/sdk": "github:arkade-os/ts-sdk#master",
    "@scure/base": "^2.0.0",
    "@scure/bip32": "^2.0.1",
    "@tetherto/wdk-wallet": "^1.0.0-beta.5",
    "bare-node-runtime": "^1.1.4",
    "light-bolt11-decoder": "^3.2.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@tetherto/wdk": "^1.0.0-beta.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@arkade-os/sdk"
    ]
  }
}
