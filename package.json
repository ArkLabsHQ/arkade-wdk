{
  "name": "@arkade-os/wdk",
  "version": "0.1.0",
  "description": "WDK (Wallet Development Kit) implementation using Arkade Bitcoin SDK with Ark protocol support",
  "main": "src/index.js",
  "type": "module",
  "exports": {
    ".": {
      "bare": "./bare.js",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test src/__tests__/*.test.js",
    "test:watch": "node --test --watch src/__tests__/*.test.js",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "lint": "eslint src --ext .js && npm run typecheck",
    "lint:fix": "eslint src --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "setup:dev": "node scripts/setup-dev.js"
  },
  "keywords": [
    "bitcoin",
    "ark",
    "wallet",
    "wdk",
    "arkade",
    "cryptocurrency",
    "blockchain"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@arkade-os/boltz-swap": "^0.3.13",
    "@arkade-os/sdk": "^0.4.14",
    "@scure/base": "^2.0.0",
    "@scure/bip32": "^2.0.1",
    "@tetherto/wdk-wallet": "^1.0.0-beta.5",
    "bare-node-runtime": "^1.1.4",
    "light-bolt11-decoder": "^3.2.0"
  },
  "devDependencies": {
    "@tetherto/wdk": "^1.0.0-beta.4",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
