{
  "name": "@arkade-os/wdk",
  "version": "0.1.3",
  "description": "WDK (Wallet Development Kit) implementation using the Arkade Bitcoin SDK",
  "main": "src/index.js",
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test src/__tests__/*.test.js",
    "test:watch": "node --test --watch src/__tests__/*.test.js",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "build:types": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build:types",
    "lint": "eslint src --ext .js && npm run typecheck",
    "lint:fix": "eslint src --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "setup:dev": "node scripts/setup-dev.js",
    "release": "node scripts/release.js"
  },
  "keywords": [
    "bitcoin",
    "ark",
    "wallet",
    "wdk",
    "arkade",
    "cryptocurrency",
    "blockchain"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@arkade-os/boltz-swap": "0.3.60",
    "@arkade-os/sdk": "0.4.55",
    "@scure/base": "^2.0.0",
    "@scure/bip32": "^2.0.1",
    "@tetherto/wdk-wallet": "^1.0.0-beta.5",
    "light-bolt11-decoder": "^3.2.0",
    "sodium-universal": "^5.0.1"
  },
  "devDependencies": {
    "@tetherto/wdk": "^1.0.0-beta.4",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "files": [
    "src",
    "types"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
